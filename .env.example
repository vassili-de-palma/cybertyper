# Copy to `.env` and fill in. `.env` is gitignored.

# Robot serial port and lerobot id
SO101_PORT=COM5
SO101_ROBOT_ID=team08_follower_arm

# OpenCV index of the wrist camera (run scripts/probe_cameras.py to find it)
CAMERA_INDEX=1

# Optional: vision-language-model anchor detector (`--detector vlm`)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional OCR tuning for the servo evals
# OCR_MULTI=1            three preprocessing variants per OCR call
# OCR_REFRESH_TICKS=15   re-detect the keyboard every N servo ticks
